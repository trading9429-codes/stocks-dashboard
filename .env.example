# ─────────────────────────────────────────────────────────────
# Stock Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Render provides this automatically as DATABASE_URL when you attach a DB.
DATABASE_URL=postgresql://user:password@localhost:5432/stocks

# Server port (optional — Render sets this automatically)
PORT=5000

# Webhook secret (optional but strongly recommended)
# Set the same value in your Chartink webhook header: X-Webhook-Secret
# If left blank, the /new-stocks endpoint accepts all requests.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Your Render app URL — used for the market-hours keep-alive self-ping.
# Prevents Render free-tier from sleeping during 9:10 AM – 3:05 PM IST (Mon–Fri).
# Example: https://your-app-name.onrender.com
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
